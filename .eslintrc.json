{
  "env": {
    "commonjs": true
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "HTTP": "readonly",
    "OvmsConfig": "readonly",
    "OvmsMetrics": "readonly",
    "OvmsNotify": "readonly",
    "PubSub": "readonly",
    "VFS": "readonly",
    "OvmsCommand": "readonly",
    "performance": "readonly",
    "print": "readonly"
  },
  "parserOptions": {
    "ecmaFeatures": {
      "impliedStrict": true
    },
    "ecmaVersion": 2015
  },
  "rules": {},
  "overrides": [
    {
      "files": ["*.test.js", "test/**/*.js"],
      "parserOptions": { "ecmaVersion": 2021 },
      "env": { "node": true }
    },
    {
      "files": ["build.js", "publish.js"],
      "env": { "node": true }
    }
  ]
}
